{
  "name": "proshop_mern",
  "type": "mixed-monorepo",
  "description": "Legacy MERN ecommerce app (Express/Mongoose API + Create React App SPA) extended with two MCP servers, a RAG retrieval pipeline, and a JSON-backed feature-flags layer.",
  "tech_stack": {
    "backend": "Node.js (ESM) + Express ^4.17.1 + Mongoose ^8.22.1",
    "auth": "jsonwebtoken ^8.5.1 + bcryptjs ^2.4.3 (JWT bearer, HS256)",
    "frontend": "React 16.13 + Redux + Redux Thunk + React Router v5 (CRA react-scripts 3.4.3)",
    "mcp_servers": "@modelcontextprotocol/sdk ^1.29 + zod ^3.25 (TypeScript)",
    "retrieval": "Qdrant (@qdrant/js-client-rest ^1.15) + Ollama bge-m3 embeddings + BM25 + cross-encoder rerank (Python)",
    "database": "MongoDB",
    "testing": "Vitest ^4.1.7 + Stryker ^9.6.1 (mutation); supertest for backend HTTP",
    "tooling": "Docker Compose; concurrently; nodemon"
  },
  "subprojects": {
    "backend": {
      "path": "backend/",
      "description": "Express/Mongoose REST API: products, users, orders, uploads, auth, PayPal config, feature-flag reads.",
      "entry": "backend/server.js",
      "tech": "Express + Mongoose (Node ESM)",
      "key_paths": {
        "routes": "backend/routes/",
        "controllers": "backend/controllers/",
        "models": "backend/models/",
        "auth_middleware": "backend/middleware/authMiddleware.js",
        "db_config": "backend/config/db.js",
        "jwt_helper": "backend/utils/generateToken.js",
        "feature_flags_store": "backend/features.json",
        "seeder": "backend/seeder.js"
      }
    },
    "frontend": {
      "path": "frontend/",
      "description": "Create React App SPA: shopping cart, checkout, profile, and admin workflows.",
      "entry": "frontend/src/index.js",
      "tech": "React 16 + Redux + Thunk + React Router v5 (CRA 3.4.3)",
      "key_paths": {
        "routing": "frontend/src/App.js",
        "store": "frontend/src/store.js",
        "actions": "frontend/src/actions/",
        "reducers": "frontend/src/reducers/",
        "constants": "frontend/src/constants/",
        "screens": "frontend/src/screens/",
        "components": "frontend/src/components/"
      }
    },
    "feature-flags-mcp": {
      "path": "mcp/feature-flags/",
      "description": "MCP server: canonical writer for backend/features.json (validation, traffic rollout, atomic writes).",
      "entry": "mcp/feature-flags/src/index.ts",
      "tech": "TypeScript + MCP SDK + zod",
      "key_paths": {
        "source": "mcp/feature-flags/src/index.ts",
        "tests": "mcp/feature-flags/test/",
        "build_output": "mcp/feature-flags/dist/"
      }
    },
    "search-docs-mcp": {
      "path": "mcp/search-docs/",
      "description": "MCP server: semantic search over the documentation corpus via Qdrant (served dense-only).",
      "entry": "mcp/search-docs/src/index.ts",
      "tech": "TypeScript + MCP SDK + Qdrant client",
      "key_paths": {
        "source": "mcp/search-docs/src/index.ts",
        "tests": "mcp/search-docs/test/"
      }
    },
    "rag": {
      "path": "rag/",
      "description": "Retrieval pipeline CLIs: ingest, dense query, hybrid (dense+BM25 RRF), and hybrid+cross-encoder rerank.",
      "entry": "rag/query.ts",
      "tech": "TypeScript (tsx) + Qdrant client + Python reranker",
      "key_paths": {
        "ingest": "rag/ingest.ts",
        "ingest_hybrid": "rag/ingest-hybrid.ts",
        "dense_query": "rag/query.ts",
        "hybrid": "rag/hybrid.ts",
        "hybrid_rerank": "rag/hybrid-rerank.ts",
        "bm25": "rag/bm25.ts",
        "reranker": "rag/rerank.ts",
        "reranker_python": "rag/rerank.py",
        "corpus": "rag/docs-corpus/"
      }
    }
  },
  "system_folders": {
    "uploads/": "User-uploaded and sample product images served as static assets.",
    "docs/": "Reference documentation: architecture overview, module specs, ADRs (start at docs/README.md).",
    "docs/adr/": "Architecture Decision Records (0001-0005). Numbering is preserved; never restart.",
    "docs/specs/": "Reverse-engineered per-module specifications.",
    "docs-archived-2026-06-01/": "Superseded documentation kept for history (e.g. the earlier FINDINGS.md table).",
    "design-system/": "Machine-readable design tokens (tokens.json, globals.css) backing DESIGN.md.",
    "rag/docs-corpus/": "Documentation corpus indexed by the search-docs MCP. Retrieval input data, NOT docs about this repo.",
    ".github/workflows/": "CI: automated cloud code review on pull requests.",
    ".claude/": "Agent configuration: subagents (agents/) and the project-index update script (scripts/).",
    "qdrant_storage/": "Local Qdrant vector-store data (collections proshop_docs, proshop_docs_hybrid)."
  },
  "root_files": {
    "package.json": "Root scripts + backend dependencies (type: module).",
    "vitest.config.js": "Backend HTTP test configuration (with supertest).",
    "docker-compose.yml": "Local stack: mongo + backend (5001) + frontend (3000).",
    "Procfile": "Heroku process definition.",
    ".env.example": "Template for required local environment variables.",
    "AGENTS.md": "Conventions, guardrails, and repo navigation for contributors and agents.",
    "README.md": "Setup, environment, and run instructions.",
    "DESIGN.md": "Visual design language (palette, type, spacing, components, states).",
    "report.md": "Project work report.",
    "project-index.json": "This file — the machine-readable repo map. Read first."
  },
  "hard_rules": [
    "ALWAYS read project-index.json FIRST at session start.",
    "For any question about project functionality, features, architecture, ADRs, runbooks, or incidents, call the search-docs MCP `search_project_docs` tool before falling back to grep+read.",
    "Change feature-flag state only through the feature-flags MCP tools; never edit backend/features.json directly.",
    "Keep backend local imports explicit with the .js extension — Node ESM resolution requires it.",
    "Do not modernize dependencies or change architecture (Next.js, Vite, TypeScript, Redux Toolkit) during docs or small fixes; isolate and verify upgrades separately.",
    "Do not change public route URLs, API response shapes, or Redux state shape without documenting the compatibility impact.",
    "Never commit .env, secrets, or real PayPal/DB credentials.",
    "All UI work must comply with DESIGN.md and design-system/ tokens."
  ],
  "ai_routing": {
    "project functionality / features / runbooks / incidents": "search-docs MCP tool `search_project_docs` (corpus under rag/docs-corpus/)",
    "feature flag status or changes": "feature-flags MCP tools (get_feature_info / list_features / set_feature_state / adjust_traffic_rollout)",
    "runtime architecture / data flow": "docs/architecture/overview.md",
    "module behavior / edge cases / decision logic": "docs/specs/<module>-spec.md",
    "architecture decisions and rationale": "docs/adr/",
    "setup / environment / how to run": "README.md",
    "conventions / guardrails / what-not-to-do": "AGENTS.md",
    "visual design / tokens / components": "DESIGN.md + design-system/",
    "known risks / security & performance findings": "homework/M6/stage1-code-review/synthesis.md"
  },
